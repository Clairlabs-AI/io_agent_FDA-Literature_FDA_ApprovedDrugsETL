# Deployment values. NOT committed to git.
# A Glue job parameter or an environment variable of the same name wins over
# anything set here, so one run can be changed without rebuilding pipeline.zip.

# --- AWS ---------------------------------------------------------------------
DATA_BUCKET=dst-aiml-sbe-etl-dev-fda-approved-drugs
AWS_REGION=ap-south-1
GLUE_JOB=dst-aiml-etl-dev-drug-labels
# Where the job writes, and where it is run from. Everything the pipeline
# produces goes under DATA_PREFIX; everything it is run by goes under CODE_PREFIX.
DATA_PREFIX=output_data
CODE_PREFIX=code
WHEELS_PREFIX=code/common_packages/wheels

# --- Notifications -----------------------------------------------------------
SNS_ENABLED=true
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:381492087190:dst-aiml-sbe-etl-dev-fda-approved-drugs
SNS_MAX_ROWS_PER_SECTION=20

# Subjects are per region so one mailbox rule can tell the two runs apart.
EU_EMAIL_SUBJECT_PREFIX=[EU-FDA Approved Drugs ETL]
EU_FAILED_EMAIL_SUBJECT_PREFIX=[EU-FDA Approved Drugs ETL] pipeline FAILED - could not download source file
US_EMAIL_SUBJECT_PREFIX=[US-FDA Approved Drugs ETL]
US_FAILED_EMAIL_SUBJECT_PREFIX=[US-FDA Approved Drugs ETL] pipeline FAILED - could not download source file

# --- HTTP pacing (both regions) ----------------------------------------------
HTTP_MIN_INTERVAL_SECONDS=0.5
HTTP_MAX_ATTEMPTS=5
HTTP_BACKOFF_SECONDS=3
HTTP_MAX_RETRY_WAIT_SECONDS=120
HTTP_TIMEOUT_SECONDS=90

# --- PDF extraction ----------------------------------------------------------
# Set true for ONE run after changing how labels are parsed, then set it back.
FORCE_PDF_REEXTRACT=false
